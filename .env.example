# ============================================================
# AI FOUND & LOST SYSTEM — ENVIRONMENT CONFIGURATION
# ============================================================

# ------------------------------------------------------------
# 1. FRONTEND CONFIGURATION (Vite)
# ------------------------------------------------------------
VITE_API_URL=/api

# Firebase Web Client SDK Configuration (Get from Firebase Console -> Project Settings -> General -> Web App)
VITE_FIREBASE_API_KEY=AIzaSyYourFirebaseWebApiKeyHere12345
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=100000000000
VITE_FIREBASE_APP_ID=1:100000000000:web:abcdef1234567890
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# Optional: Firebase App Check (reCAPTCHA v3)
VITE_RECAPTCHA_SITE_KEY=6LeIx0cYAAAAANonRealSiteKeyHereForProduction

# ------------------------------------------------------------
# 2. BACKEND CONFIGURATION (FastAPI / Python)
# ------------------------------------------------------------
PROJECT_NAME="Smart Campus Lost & Found System"
FRONTEND_URL=http://localhost:5173

# Database URL (MongoDB connection string, or leaves empty for persistent Dev DB fallback)
DATABASE_URL=mongodb://localhost:27017
MONGODB_DB_NAME=smart_campus_lost_found

# Security & Secrets (Change in production!)
JWT_SECRET=super_secret_jwt_key_smart_campus_lost_found_2026_change_in_production
SESSION_SECRET=super_secret_session_key_2026

# Firebase Admin SDK (Get JSON service account from Firebase Console -> Project Settings -> Service Accounts)
FIREBASE_SERVICE_ACCOUNT_PATH=
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_PROJECT_ID=your-project-id

# Email SMTP Settings (Leave empty for simulated Dev Console email logging)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_FROM=noreply@campuslostfound.edu

# SMS / Mobile OTP Provider Settings (Leave empty for Dev Console OTP logging)
SMS_PROVIDER=
SMS_API_KEY=
SMS_API_SECRET=
SMS_FROM=+18005550199
